# local environments, caches and package builds stay out of the source history.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store
.env
.env.*
!.env.example

# downloaded data and run outputs are reproducible inputs and outputs, not source.
artifacts/
data/*
!data/README.md
runs/*
# frozen four-method evidence from the closed 30-image exploration.
!runs/post1_predictions_with_full_image.json
!runs/post1_confidence_sweep_full_image.csv

# publish selected figures, keeping bulk image renders local.
results/post1/figures/predictions/

# record where weights came from and their hashes instead of committing them.
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
