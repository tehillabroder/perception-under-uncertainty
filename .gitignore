# local environments, caches and package builds stay out of the source history.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store
.env
.env.*
!.env.example

# downloaded data and run outputs are reproducible inputs and outputs, not source.
artifacts/
data/*
!data/README.md
runs/*
# frozen four-method evidence from the closed 30-image exploration.
!runs/post1_predictions_with_full_image.json
!runs/post1_confidence_sweep_full_image.csv
# allow only the completed 300-image run files and five selected figures.
# keep other files in this run, including future renders, local.
!runs/dut_300_evaluation/
runs/dut_300_evaluation/*
!runs/dut_300_evaluation/README.md
!runs/dut_300_evaluation/predictions.json
!runs/dut_300_evaluation/run_manifest.json
!runs/dut_300_evaluation/summary.csv
!runs/dut_300_evaluation/confidence_sweep.csv
!runs/dut_300_evaluation/latencies.csv
!runs/dut_300_evaluation/visuals/
runs/dut_300_evaluation/visuals/*
!runs/dut_300_evaluation/visuals/00395_comparison.png
!runs/dut_300_evaluation/visuals/00150_comparison.png
!runs/dut_300_evaluation/visuals/00224_comparison.png
!runs/dut_300_evaluation/visuals/00622_comparison.png
!runs/dut_300_evaluation/visuals/00787_comparison.png

# publish selected figures, keeping bulk image renders local.
results/post1/figures/predictions/

# record where weights came from and their hashes instead of committing them.
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
